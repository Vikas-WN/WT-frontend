# Copy to `.env.local` and adjust for your environment.

# Leave empty in production so the browser calls same-origin /api/v1/* (Next.js BFF).
# For direct local API access without the BFF, set http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=

# Server-side upstream API for server-side BFF routes (google callback, refresh, proxy).
# REQUIRED on every deployed environment (develop + UAT). Example:
# API_BASE_URL=https://webtrak-api.webknot-dev.in
API_BASE_URL=http://localhost:8080

# Public frontend origin used for OAuth redirect URIs in production.
# Set per environment (develop vs UAT). Example:
# APP_URL=https://webtrak.webknot-dev.in
APP_URL=https://webtrak.webknot-dev.in

# Session policy (display + client timers; must match backend SESSION_* values).
NEXT_PUBLIC_SESSION_INACTIVITY_MINUTES=30
NEXT_PUBLIC_SESSION_MAX_HOURS=8

# Google OAuth client id (public). Used by /api/v1/google-signin on the frontend host.
GOOGLE_CLIENT_ID=

# Linode Object Storage — required for holiday calendar file upload/download.
# Copy these into `.env.local` for local development.
# Use the REGIONAL endpoint (https://{region}.linodeobjects.com), NOT the bucket hostname
# (e.g. not https://{bucket}.{region}.linodeobjects.com).
LINODE_OBJECT_STORAGE_REGION=in-maa-1
LINODE_OBJECT_STORAGE_ENDPOINT=https://in-maa-1.linodeobjects.com
LINODE_OBJECT_STORAGE_BUCKET=
LINODE_OBJECT_STORAGE_ACCESS_KEY=
LINODE_OBJECT_STORAGE_SECRET_KEY=
